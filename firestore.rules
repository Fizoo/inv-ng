rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Доступ лише для користувача, що увійшов (спільний акаунт бару).
    match /events/{eventId} {
      allow read, write: if request.auth != null;
      match /ops/{opId} {
        allow read, delete: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.keys().hasOnly(['itemId', 'type', 'qty', 'ts'])
          && request.resource.data.type in ['add', 'sub']
          && request.resource.data.qty is number
          && request.resource.data.qty > 0;
      }
    }
  }
}
